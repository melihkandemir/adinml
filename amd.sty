% % 		Chapters and sections 
% %--------------------------------------------------------------------------
\renewcommand\thesubsubsection{\thesubsection.\arabic{subsubsection}}
\renewcommand\thesubsection{\thesection.\arabic{subsection}}
\renewcommand\thesection{\thechapter.\arabic{section}}

\makeatletter
\@addtoreset{chapter}{part} % for numberring
\makeatother  

\RequirePackage[titles]{tocloft}

\RequirePackage{titletoc}
% Define a new command to create per-chapter mini-TOCs
\newcommand{\chaptertoc}{%
    \startcontents[chapters]
    \printcontents[chapters]{}{1}{\setcounter{tocdepth}{1}}
    \vspace{0.5cm}
}

\newcommand{\intro}[1]{
\noindent
\begin{minipage}[t]{0.48\textwidth}
    \chaptertoc
\end{minipage}%
\hfill
\begin{minipage}[t]{0.48\textwidth}
    #1
\end{minipage}
\newpage
}


\RequirePackage[explicit]{titlesec}
\RequirePackage{titlesec}

\titleformat{\chapter}[display]
{\centering\normalfont\Huge\color{mondrianblue}}
{{\color{mondrianred}\titlerule[5pt]}\vspace{3pt}{\color{mondrianred}\titlerule[2pt]}\vspace{3pt}\textbf{\MakeUppercase{\chaptername} \thechapter}}
{0pt}
{{\color{mondrianred}\titlerule[2pt]}\vspace{1pc}\Huge\MakeUppercase{#1}}

\titleformat{name=\chapter,numberless}[display]
{  \centering\normalfont\Huge\color{mondrianblue}}
{{\color{mondrianred}\titlerule[2pt]}\vspace{-20pt}}
{0pt}
{\Huge\MakeUppercase{#1} \addcontentsline{toc}{chapter}{#1} }

% Section-level headings in Mondrian blue, keeping the book class's default
% sizes/weights (Large/large/normalsize, all bold).
\titleformat{\section}
{\normalfont\Large\bfseries\color{mondrianblue}}{\thesection}{1em}{#1}
\titleformat{\subsection}
{\normalfont\large\bfseries\color{mondrianblue}}{\thesubsection}{1em}{#1}
\titleformat{\subsubsection}
{\normalfont\normalsize\bfseries\color{mondrianblue}}{\thesubsubsection}{1em}{#1}





